<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="Theme.ElderlyCareCoordination" parent="Theme.ElderlyCareCoordination.Dark">
        <item name="android:colorPrimary">@color/primary_green</item>
        <item name="android:color">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/primary_green</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.ElderlyCareCoordination.Dark" parent="Theme.ElderlyCareCoordination">
        <item name="android:colorPrimary">@color/primary_green</item>
        <item name="android:color">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/primary_green</item>
    </style>
</resources>
